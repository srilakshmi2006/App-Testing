<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="2dp">
        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#0F172A" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Analysis Result"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Cancer Risk Percentage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="20dp"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancer Risk Percentage"
                    android:textColor="#4B5563"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp">
                    <!-- A simple circular progress representation -->
                    <ProgressBar
                        android:id="@+id/riskProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:progress="0"
                        android:progressDrawable="@drawable/circular_progress"
                        android:max="100"/>
                    <TextView
                        android:id="@+id/riskPercentageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="0%"
                        android:textColor="#111827"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/riskClassificationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Healthy"
                    android:textColor="#10B981"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:background="#D1FAE5"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp" />
            </LinearLayout>

            <!-- Biomarker Graph -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Biomarker Analysis"
                    android:textColor="#4B5563"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />
                
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/biomarkerChart"
                    android:layout_width="match_parent"
                    android:layout_height="250dp" />
            </LinearLayout>

            <!-- AI Prediction Output -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Prediction Summary"
                    android:textColor="#4B5563"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:id="@+id/aiPredictionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Processing..."
                    android:textColor="#1F2937"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <!-- Recommendations -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="20dp"
                android:layout_marginBottom="24dp"
                android:elevation="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recommendations"
                    android:textColor="#4B5563"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:id="@+id/recommendationsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Maintain regular checkups."
                    android:textColor="#1F2937"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <!-- Download Button -->
            <Button
                android:id="@+id/downloadPdfBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Download PDF Report"
                android:backgroundTint="#10B981"
                android:textColor="@android:color/white"
                android:padding="16dp"
                android:layout_marginBottom="16dp" />

            <!-- History Action Buttons (Share and Delete) -->
            <LinearLayout
                android:id="@+id/historyActionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginBottom="32dp"
                android:weightSum="2">

                <Button
                    android:id="@+id/shareReportBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Share"
                    android:backgroundTint="#3B82F6"
                    android:textColor="@android:color/white"
                    android:padding="16dp" />

                <Button
                    android:id="@+id/deleteReportBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Delete"
                    android:backgroundTint="#EF4444"
                    android:textColor="@android:color/white"
                    android:padding="16dp" />
            </LinearLayout>

            <!-- Return to Dashboard Button -->
            <Button
                android:id="@+id/returnDashboardBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Return to Dashboard"
                android:backgroundTint="#F3F4F6"
                android:textColor="#374151"
                android:padding="16dp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
